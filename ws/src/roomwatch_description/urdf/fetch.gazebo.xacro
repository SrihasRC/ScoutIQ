<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Add four casters to the base -->
  <xacro:macro name="caster" params="prefix joint_x joint_y">
    <link name="${prefix}_caster_link">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <sphere radius="0.0601"/>
        </geometry>
        <material name="">
          <color rgba="0.086 0.506 0.767 1"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <sphere radius="0.0601"/>
        </geometry>
      </collision>
      <inertial>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <mass value="0.01"/>
      </inertial>
    </link>
    <gazebo reference="${prefix}_caster_link">
      <mu1>0.1</mu1>
      <mu2>0.1</mu2>
      <kp>100000000.0</kp>
      <kd>10.0</kd>
      <maxVel>10.0</maxVel>
      <minDepth>0.001</minDepth>
    </gazebo>
    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster_link"/>
      <origin rpy="0 0 0" xyz="${joint_x} ${joint_y} 0.055325"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:caster prefix="fl" joint_x="0.15" joint_y="0.12"/>
  <xacro:caster prefix="fr" joint_x="0.15" joint_y="-0.12"/>
  <xacro:caster prefix="br" joint_x="-0.2" joint_y="0.12"/>
  <xacro:caster prefix="bl" joint_x="-0.2" joint_y="-0.12"/>

  <!-- Base is modeled as a big tub sitting on floor, with two wheels -->
  <gazebo reference="base_link">
    <kp>100000000.0</kp>
    <kd>10.0</kd>
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <fdir1>1 0 0</fdir1>
    <maxVel>10.0</maxVel>
    <minDepth>0.0005</minDepth>
  </gazebo>

  <gazebo reference="r_wheel_link">
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <mu1>100.0</mu1>
    <mu2>100.0</mu2>
    <maxVel>1.0</maxVel>
    <minDepth>0.01</minDepth>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="l_wheel_link">
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <mu1>100.0</mu1>
    <mu2>100.0</mu2>
    <maxVel>1.0</maxVel>
    <minDepth>0.01</minDepth>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="l_wheel_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
  </gazebo>
  <gazebo reference="r_wheel_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
  </gazebo>
  <gazebo reference="forearm_roll_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
  </gazebo>
  <gazebo reference="wrist_roll_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
  </gazebo>

  <!-- Gripper links -->
  <gazebo reference="r_gripper_finger_link">
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <mu1>30.0</mu1>
    <mu2>30.0</mu2>
    <maxVel>1.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="l_gripper_finger_link">
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <mu1>30.0</mu1>
    <mu2>30.0</mu2>
    <maxVel>1.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- Materials for visual elements -->
  <gazebo reference="bellows_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="bellows_link2">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="estop_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <!-- SICK TIM561 (25m Range) via gpu_lidar -->
  <gazebo reference="laser_link">
    <sensor name="base_laser" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <ignition_frame_id>laser_link</ignition_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>25.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Primesense Carmine 1.09 RGB-D camera -->
  <gazebo reference="head_camera_rgb_optical_frame">
    <sensor name="head_camera" type="rgbd_camera">
      <pose>0 0 0 1.57079632679 -1.57079632679 0</pose>
      <topic>head_camera</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <ignition_frame_id>head_camera_rgb_optical_frame</ignition_frame_id>
      <camera>
        <horizontal_fov>1.047197</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Differential Drive System Plugin -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>l_wheel_joint</left_joint>
      <right_joint>r_wheel_joint</right_joint>
      <wheel_separation>0.3748</wheel_separation>
      <wheel_radius>0.0601</wheel_radius>
      <odom_publish_frequency>20</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>
  </gazebo>

  <!-- Joint State Publisher System Plugin -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

  <!-- Joint Position Controllers for Arm, Head, and Torso -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>torso_lift_joint</joint_name>
      <topic>/torso_lift_joint/cmd_pos</topic>
      <p_gain>20000.0</p_gain>
      <i_gain>100.0</i_gain>
      <d_gain>1000.0</d_gain>
      <cmd_max>450.0</cmd_max>
      <cmd_min>-450.0</cmd_min>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>shoulder_pan_joint</joint_name>
      <topic>/shoulder_pan_joint/cmd_pos</topic>
      <p_gain>200.0</p_gain>
      <i_gain>1.0</i_gain>
      <d_gain>10.0</d_gain>
      <cmd_max>33.8</cmd_max>
      <cmd_min>-33.8</cmd_min>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>shoulder_lift_joint</joint_name>
      <topic>/shoulder_lift_joint/cmd_pos</topic>
      <p_gain>1000.0</p_gain>
      <i_gain>10.0</i_gain>
      <d_gain>50.0</d_gain>
      <cmd_max>131.0</cmd_max>
      <cmd_min>-131.0</cmd_min>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>upperarm_roll_joint</joint_name>
      <topic>/upperarm_roll_joint/cmd_pos</topic>
      <p_gain>200.0</p_gain>
      <i_gain>1.0</i_gain>
      <d_gain>10.0</d_gain>
      <cmd_max>76.0</cmd_max>
      <cmd_min>-76.0</cmd_min>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>elbow_flex_joint</joint_name>
      <topic>/elbow_flex_joint/cmd_pos</topic>
      <p_gain>500.0</p_gain>
      <i_gain>5.0</i_gain>
      <d_gain>25.0</d_gain>
      <cmd_max>66.0</cmd_max>
      <cmd_min>-66.0</cmd_min>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>forearm_roll_joint</joint_name>
      <topic>/forearm_roll_joint/cmd_pos</topic>
      <p_gain>100.0</p_gain>
      <i_gain>0.5</i_gain>
      <d_gain>5.0</d_gain>
      <cmd_max>29.0</cmd_max>
      <cmd_min>-29.0</cmd_min>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>wrist_flex_joint</joint_name>
      <topic>/wrist_flex_joint/cmd_pos</topic>
      <p_gain>100.0</p_gain>
      <i_gain>0.5</i_gain>
      <d_gain>5.0</d_gain>
      <cmd_max>25.0</cmd_max>
      <cmd_min>-25.0</cmd_min>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>wrist_roll_joint</joint_name>
      <topic>/wrist_roll_joint/cmd_pos</topic>
      <p_gain>50.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>2.0</d_gain>
      <cmd_max>7.0</cmd_max>
      <cmd_min>-7.0</cmd_min>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>head_pan_joint</joint_name>
      <topic>/head_pan_joint/cmd_pos</topic>
      <p_gain>20.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>2.0</d_gain>
      <cmd_max>10.0</cmd_max>
      <cmd_min>-10.0</cmd_min>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>head_tilt_joint</joint_name>
      <topic>/head_tilt_joint/cmd_pos</topic>
      <p_gain>30.0</p_gain>
      <i_gain>0.5</i_gain>
      <d_gain>3.0</d_gain>
      <cmd_max>10.0</cmd_max>
      <cmd_min>-10.0</cmd_min>
    </plugin>
  </gazebo>

</robot>
