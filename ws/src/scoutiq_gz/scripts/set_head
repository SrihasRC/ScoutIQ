#!/usr/bin/env python3
"""
Set Fetch head pan and tilt to look at target coordinates or explicit angles.
Default angles match looking at point (0.75, 0, 0.75) in base_link:
  pan: 0.0 rad
  tilt: 0.394 rad (~22.6 deg down)
"""

import argparse
import math
import sys
import time

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import JointState
from std_msgs.msg import Float64


class SetHeadNode(Node):
    def __init__(self, pan=0.0, tilt=0.394, tolerance=0.05, timeout=10.0, wait=True):
        super().__init__('set_head')
        self.pan_target = pan
        self.tilt_target = tilt
        self.tolerance = tolerance
        self.timeout = timeout
        self.wait = wait

        self.current_pan = None
        self.current_tilt = None

        self.pub_pan = self.create_publisher(Float64, '/head_pan_joint/cmd_pos', 10)
        self.pub_tilt = self.create_publisher(Float64, '/head_tilt_joint/cmd_pos', 10)

        self.sub = self.create_subscription(
            JointState,
            '/joint_states',
            self._joint_state_cb,
            10,
        )

    def _joint_state_cb(self, msg: JointState):
        for name, pos in zip(msg.name, msg.position):
            if name == 'head_pan_joint':
                self.current_pan = pos
            elif name == 'head_tilt_joint':
                self.current_tilt = pos

    def is_target_reached(self) -> bool:
        if self.current_pan is None or self.current_tilt is None:
            return False
        pan_err = abs(self.current_pan - self.pan_target)
        tilt_err = abs(self.current_tilt - self.tilt_target)
        return pan_err <= self.tolerance and tilt_err <= self.tolerance

    def publish_commands(self):
        msg_pan = Float64()
        msg_pan.data = float(self.pan_target)
        self.pub_pan.publish(msg_pan)

        msg_tilt = Float64()
        msg_tilt.data = float(self.tilt_target)
        self.pub_tilt.publish(msg_tilt)


def main(args=None):
    parser = argparse.ArgumentParser(description='Orient the robot head')
    parser.add_argument('--pan', type=float, default=None, help='Head pan angle (rad)')
    parser.add_argument('--tilt', type=float, default=None, help='Head tilt angle (rad)')
    parser.add_argument('--look-at', nargs=3, type=float, metavar=('X', 'Y', 'Z'),
                        help='Target point in base_link (e.g. 0.75 0 0.75)')
    parser.add_argument('--timeout', type=float, default=10.0, help='Max seconds to wait')
    parser.add_argument('--tolerance', type=float, default=0.08, help='Tolerance in rad')
    parser.add_argument('--no-wait', dest='wait', action='store_false', help='Do not wait for target reached')
    parsed_args, ros_args = parser.parse_known_args(args)

    pan = 0.0
    tilt = 0.394

    if parsed_args.look_at is not None:
        lx, ly, lz = parsed_args.look_at
        # Camera tilt origin relative to base_link at nominal torso pose
        cam_x = 0.1088
        cam_y = 0.0
        cam_z = 1.0384
        dx = lx - cam_x
        dy = ly - cam_y
        dz = lz - cam_z
        dist_xy = math.sqrt(dx * dx + dy * dy)
        pan = math.atan2(dy, dx)
        tilt = -math.atan2(dz, dist_xy)
    else:
        if parsed_args.pan is not None:
            pan = parsed_args.pan
        if parsed_args.tilt is not None:
            tilt = parsed_args.tilt

    rclpy.init(args=ros_args)
    node = SetHeadNode(
        pan=pan,
        tilt=tilt,
        tolerance=parsed_args.tolerance,
        timeout=parsed_args.timeout,
        wait=parsed_args.wait,
    )

    node.get_logger().info(f'Setting head to pan={pan:.3f}, tilt={tilt:.3f} rad...')
    start_time = time.time()
    rate_period = 0.05

    try:
        while rclpy.ok():
            rclpy.spin_once(node, timeout_sec=rate_period)
            node.publish_commands()

            if not node.wait:
                node.get_logger().info('Commands sent (--no-wait). Exiting.')
                break

            if node.is_target_reached():
                node.get_logger().info('Target head configuration reached!')
                break

            elapsed = time.time() - start_time
            if elapsed > node.timeout:
                node.get_logger().warn(f'Timeout ({node.timeout}s) waiting for head configuration.')
                break
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main(sys.argv[1:])
