<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roomwatch_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch files, orchestration, and RViz configurations for roomwatch</description>
  <maintainer email="srihasrc@todo.todo">roomwatch</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>roomwatch_world</exec_depend>
  <exec_depend>roomwatch_description</exec_depend>
  <exec_depend>roomwatch_gz</exec_depend>
  <exec_depend>roomwatch_nav</exec_depend>
  <exec_depend>roomwatch_explore</exec_depend>
  <exec_depend>roomwatch_core</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
