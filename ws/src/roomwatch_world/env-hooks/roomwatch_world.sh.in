# Set IGN_GAZEBO_RESOURCE_PATH, GZ_SIM_RESOURCE_PATH, SDF_PATH
_ROOMWATCH_WORLD_MODELS="@CMAKE_INSTALL_PREFIX@/share/@PROJECT_NAME@/models"
if [ -z "${IGN_GAZEBO_RESOURCE_PATH}" ]; then
  export IGN_GAZEBO_RESOURCE_PATH="$_ROOMWATCH_WORLD_MODELS"
else
  export IGN_GAZEBO_RESOURCE_PATH="$_ROOMWATCH_WORLD_MODELS:${IGN_GAZEBO_RESOURCE_PATH}"
fi
if [ -z "${GZ_SIM_RESOURCE_PATH}" ]; then
  export GZ_SIM_RESOURCE_PATH="$_ROOMWATCH_WORLD_MODELS"
else
  export GZ_SIM_RESOURCE_PATH="$_ROOMWATCH_WORLD_MODELS:${GZ_SIM_RESOURCE_PATH}"
fi
if [ -z "${SDF_PATH}" ]; then
  export SDF_PATH="$_ROOMWATCH_WORLD_MODELS"
else
  export SDF_PATH="$_ROOMWATCH_WORLD_MODELS:${SDF_PATH}"
fi
unset _ROOMWATCH_WORLD_MODELS
