#!/usr/bin/env python3
"""
Tuck Fetch arm and set torso lift in simulation or real robot.
Joint targets from CONTRACT.md:
  torso_lift_joint: 0.05
  shoulder_pan_joint: 1.32
  shoulder_lift_joint: 1.40
  upperarm_roll_joint: -0.2
  elbow_flex_joint: 1.72
  forearm_roll_joint: 0.0
  wrist_flex_joint: 1.66
  wrist_roll_joint: 0.0
"""

import argparse
import sys
import time

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import JointState
from std_msgs.msg import Float64

TUCKED_JOINTS = {
    'torso_lift_joint': 0.05,
    'shoulder_pan_joint': 1.32,
    'shoulder_lift_joint': 1.40,
    'upperarm_roll_joint': -0.2,
    'elbow_flex_joint': 1.72,
    'forearm_roll_joint': 0.0,
    'wrist_flex_joint': 1.66,
    'wrist_roll_joint': 0.0,
}


class TuckArmNode(Node):
    def __init__(self, targets=None, tolerance=0.1, timeout=15.0, wait=True):
        super().__init__('tuck_arm')
        self.targets = targets or TUCKED_JOINTS
        self.tolerance = tolerance
        self.timeout = timeout
        self.wait = wait

        self.current_positions = {}
        self.publishers_dict = {}

        for joint in self.targets.keys():
            pub = self.create_publisher(Float64, f'/{joint}/cmd_pos', 10)
            self.publishers_dict[joint] = pub

        self.sub = self.create_subscription(
            JointState,
            '/joint_states',
            self._joint_state_cb,
            10,
        )

        self.start_time = time.time()
        self.reached = False

    def _joint_state_cb(self, msg: JointState):
        for name, pos in zip(msg.name, msg.position):
            self.current_positions[name] = pos

    def is_target_reached(self) -> bool:
        if not self.targets:
            return True
        for joint, target_val in self.targets.items():
            if joint not in self.current_positions:
                return False
            curr = self.current_positions[joint]
            if abs(curr - target_val) > self.tolerance:
                return False
        return True

    def publish_commands(self):
        for joint, target_val in self.targets.items():
            msg = Float64()
            msg.data = float(target_val)
            self.publishers_dict[joint].publish(msg)


def main(args=None):
    parser = argparse.ArgumentParser(description='Tuck the robot arm')
    parser.add_argument('--timeout', type=float, default=15.0, help='Max seconds to wait')
    parser.add_argument('--tolerance', type=float, default=0.15, help='Position tolerance in rad/m')
    parser.add_argument('--no-wait', dest='wait', action='store_false', help='Do not wait for target reached')
    parsed_args, ros_args = parser.parse_known_args(args)

    rclpy.init(args=ros_args)
    node = TuckArmNode(
        tolerance=parsed_args.tolerance,
        timeout=parsed_args.timeout,
        wait=parsed_args.wait,
    )

    node.get_logger().info('Publishing arm tuck commands...')
    start_time = time.time()
    rate_period = 0.05  # 20 Hz

    try:
        while rclpy.ok():
            rclpy.spin_once(node, timeout_sec=rate_period)
            node.publish_commands()

            if not node.wait:
                node.get_logger().info('Commands sent (--no-wait). Exiting.')
                break

            if node.is_target_reached():
                node.get_logger().info('Target arm tuck configuration reached!')
                break

            elapsed = time.time() - start_time
            if elapsed > node.timeout:
                node.get_logger().warn(f'Timeout ({node.timeout}s) waiting for arm tuck configuration.')
                break
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main(sys.argv[1:])
